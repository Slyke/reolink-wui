{
  "compilerOptions": {
    "target": "ES2024",
    "strict": true,
    "module": "NodeNext",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["server/**/*", "shared/**/*"]
}
